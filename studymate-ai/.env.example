# ─────────────────────────────────────────────
# StudyMate AI — Environment Configuration
# ─────────────────────────────────────────────
# Copy this file to .env and fill in your values:
#   copy .env.example .env        (Windows)
#   cp .env.example .env          (Mac/Linux)
#
# NEVER commit the real .env file to Git!
# ─────────────────────────────────────────────

# ── OpenAI API Key (REQUIRED) ────────────────
# Get your key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key-here

# ── Model Configuration ─────────────────────
# GPT-4o mini is fast, cheap, and great for students
OPENAI_MODEL=gpt-4o-mini

# Maximum tokens per AI response
MAX_TOKENS=2048

# Sampling temperature (0.0 = deterministic, 1.0 = creative)
TEMPERATURE=0.7

# ── Server Configuration ────────────────────
# Port the server listens on (AWS App Runner uses 8080)
PORT=8080

# CORS origins (comma-separated, or * for all)
ALLOWED_ORIGINS=*

# ── Advanced (AI Workspace — app/ directory) ─
# These are only needed if running the full AI Workspace (app/main.py).
# The StudyMate backend (backend/main.py) only needs the settings above.
#
# APP_NAME=AI Workspace
# SECRET_KEY=your-super-secret-key-change-this
# DATABASE_URL=sqlite:///./ai_workspace.db
# AI_PROVIDER=openai
# ANTHROPIC_API_KEY=sk-ant-your-key-here
# GOOGLE_API_KEY=your-google-api-key-here
